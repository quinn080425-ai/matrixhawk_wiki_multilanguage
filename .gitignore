# --- System & IDE ---
.DS_Store
.vscode/
.idea/
.venv/
*.swp
*.pyc
__pycache__/

# --- Build Output (Recursive) ---
# Ignores 'build' folder in any directory
build/
*.html
!/frontend/*.html
!/frontend/includes/*.html

# --- Logs ---
*.log

# --- Auto-generated Documentation (by update.py) ---
# 1. Common docs copied to sub-projects
# Ignore common-* in any source/docs folder...
**/source/docs/common-*.rst
# ...BUT keep the original ones in the 'common' folder
!/common/source/docs/common-*.rst

# 2. Common CSS copied to sub-projects
**/source/_static/common_*
!/common/source/_static/common_*

# 3. Parameters & Features (Auto-generated)
**/source/docs/parameters*.rst
**/source/docs/features*.rst
**/source/docs/binary-features.rst
**/source/docs/logmessages.rst
/dev/source/docs/AP_Periph-Parameters.rst

# --- Downloaded Data ---
features.json.gz
build_options.py

# --- Website/Javascript ---
**/source/_static/useralerts.js
/frontend/blog_posts.json
/frontend/news_posts.json
/frontend/source/_static/common_theme_override.css

# --- Vagrant ---
.vagrant/
